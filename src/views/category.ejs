<%- include('partials/header') %>
<main>
    <h1><%= title %></h1>
    <h2><%= category.name %></h2>
    <p><a href="/edit-category/<%= category.category_id %>">Edit Category</a></p>

    <h3>Service Projects</h3>
    <% if (projects.length > 0) { %>
        <ul class="styled-list">
            <% projects.forEach(project => { %>
                <li>
                    <a href="/project/<%= project.project_id %>"><%= project.title %></a>
                </li>
            <% }); %>
        </ul>
    <% } else { %>
        <p>No service projects are currently available in this category.</p>
    <% } %>
</main>
<%- include('partials/footer') %>
