<%- include('partials/header') %>
<main>
    <h1><%= title %></h1>
    <h2>Dashboard</h2>
    <p>Name: <%= name %></p>
    <p>Email: <%= email %></p>
    <% if (user && user.role_name === 'admin') { %>
        <p><a href="/users">View Registered Users</a></p>
    <% } %>
    <h2>Projects I Am Volunteering For</h2>
    <% if (volunteerProjects.length > 0) { %>
        <ul class="styled-list">
            <% volunteerProjects.forEach(project => { %>
                <li>
                    <h3><a href="/project/<%= project.project_id %>"><%= project.title %></a></h3>
                    <p>
                        <%= new Date(project.project_date).toLocaleDateString('en-US', {
                            year: 'numeric',
                            month: 'short',
                            day: 'numeric'
                        }) %>
                        - <%= project.location %>
                    </p>
                    <p>Organization: <%= project.organization_name %></p>
                    <form action="/dashboard/projects/<%= project.project_id %>/remove-volunteer" method="POST">
                        <button type="submit">Remove me as a volunteer</button>
                    </form>
                </li>
            <% }); %>
        </ul>
    <% } else { %>
        <p>You have not signed up to volunteer for any projects yet.</p>
    <% } %>
</main>
<%- include('partials/footer') %>
