<!-- views/projects.ejs -->
<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <title>Service Projects</title>
</head>

<body>
    <h1>Available Service Projects</h1>

    <ul>
        <% projects.forEach(project=> { %>
            <li>
                <strong>
                    <%= new Date(project.project_date).toLocaleDateString('en-US', { year: 'numeric' , month: 'short' ,
                        day: 'numeric' }) %>:
                </strong>
                <%= project.title %> (<%= project.organization_name %>)
                        <p>
                            <%= project.description %> - Location: <%= project.location %>
                        </p>
            </li>
            <% }) %>
    </ul>
</body>

</html>