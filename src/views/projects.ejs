<%- include('partials/header') %>
    <main>
        <section class="page-header">
            <h1>
                <%= title %>
            </h1>
            <p>Browse our current service opportunities below.</p>
            <p><a href="/new-project">Add a New Service Project</a></p>
        </section>
        <section class="list-section">
            <ul class="styled-list">
                <% projects.forEach(project => { %>
                    <li>
                        <h2>
                            <a href="/project/<%= project.project_id %>">
                                <%= project.title %>
                            </a>
                        </h2>
                        <p>
                            <a href="/organization/<%= project.organization_id %>">
                                <%= project.organization_name %>
                            </a>
                        </p>
                        <p>
                            <%= new Date(project.project_date).toLocaleDateString('en-US', { year: 'numeric',
                                month: 'short', day: 'numeric' }) %>
                            &mdash; Location: <%= project.location %>
                        </p>
                    </li>
                    <% }); %>
            </ul>
        </section>
    </main>
    <%- include('partials/footer') %>