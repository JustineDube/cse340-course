<%- include('partials/header') %>
    <main>
        <section class="page-header">
            <h1>
                <%= title %>
            </h1>
            <p>Browse our current service opportunities below.</p>
        </section>
        <section class="list-section">
            <ul class="styled-list">
                <% projects.forEach(project=> { %>
                    <li>
                        <h2>
                            <%= new Date(project.project_date).toLocaleDateString('en-US', { year: 'numeric' ,
                                month: 'short' , day: 'numeric' }) %>:
                                <%= project.title %> (<%= project.organization_name %>)
                        </h2>
                        <p>
                            <%= project.description %> &mdash; Location: <%= project.location %>
                        </p>
                    </li>
                    <% }); %>
            </ul>
        </section>
    </main>
    <%- include('partials/footer') %>