<%- include('partials/header') %>
<main>
    <h1><%= title %></h1>

    <h2><%= project.title %></h2>
    <p><%= project.description %></p>
    <p>
        Date:
        <%= new Date(project.project_date).toLocaleDateString('en-US', {
            year: 'numeric',
            month: 'long',
            day: 'numeric'
        }) %>
    </p>
    <p>Location: <%= project.location %></p>
    <p>
        Organization:
        <a href="/organization/<%= project.organization_id %>">
            <%= project.organization_name %>
        </a>
    </p>
    <% if (user) { %>
        <% if (isVolunteering) { %>
            <p>You are volunteering for this project.</p>
            <form action="/project/<%= project.project_id %>/remove-volunteer" method="POST">
                <button type="submit">Remove me as a volunteer</button>
            </form>
        <% } else { %>
            <form action="/project/<%= project.project_id %>/volunteer" method="POST">
                <button type="submit">Volunteer for this project</button>
            </form>
        <% } %>
    <% } %>
    <% if (user && user.role_name === 'admin') { %>
        <p><a href="/edit-project/<%= project.project_id %>">Edit Project</a></p>
        <p><a href="/project/<%= project.project_id %>/assign-categories">Edit Categories</a></p>
    <% } %>

    <h3>Categories</h3>
    <% if (categories.length > 0) { %>
        <ul class="category-list">
            <% categories.forEach(category => { %>
                <li>
                    <a href="/category/<%= category.category_id %>"><%= category.name %></a>
                </li>
            <% }); %>
        </ul>
    <% } else { %>
        <p>No categories are assigned to this project.</p>
    <% } %>
</main>
<%- include('partials/footer') %>
