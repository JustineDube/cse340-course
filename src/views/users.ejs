<%- include('partials/header') %>
<main>
    <h1><%= title %></h1>
    <p>Registered users and their assigned roles.</p>
    <% if (users.length > 0) { %>
        <div class="table-scroll">
            <table class="data-table">
                <thead>
                    <tr>
                        <th scope="col">Name</th>
                        <th scope="col">Email</th>
                        <th scope="col">Role</th>
                    </tr>
                </thead>
                <tbody>
                    <% users.forEach(registeredUser => { %>
                        <tr>
                            <td><%= registeredUser.name %></td>
                            <td><%= registeredUser.email %></td>
                            <td><%= registeredUser.role_name || 'Unassigned' %></td>
                        </tr>
                    <% }); %>
                </tbody>
            </table>
        </div>
    <% } else { %>
        <p>No users are currently registered.</p>
    <% } %>
</main>
<%- include('partials/footer') %>
