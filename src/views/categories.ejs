<!-- src/views/categories.ejs -->
<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <title>
        <%= title %>
    </title>
</head>

<body>
    <h1>
        <%= title %>
    </h1>

    <p>Browse our projects by the following categories:</p>

    <ul>
        <% categories.forEach(category=> { %>
            <li>
                <%= category.name %>
            </li>
            <% }) %>
    </ul>
</body>

</html>